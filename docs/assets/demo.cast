[0.059, "o", "\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 TimeMachine is ready \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n\u2502 Ready to checkpoint \u00b7                                                        \u2502\r\n\u2502 /private/var/folders/v5/65lp57953gl7fdvcjct3ymz00000gn/T/timemachine-recordi \u2502\r\n\u2502 ng-9xnfq9vu/project                                                          \u2502\r\n\u2502                                                                              \u2502\r\n\u2502 Initialization does not create a backup or watch for changes.                \u2502\r\n\u2502 Protects selected file bytes, modes, directories and link targets.           \u2502\r\n\u2502 Snapshots:                                                                   \u2502\r\n\u2502 /private/var/folders/v5/65lp57953gl7fdvcjct3ymz00000gn/T/timemachine-recordi \u2502\r\n\u2502 ng-9xnfq9vu/store                                                            \u2502\r\n\u2502 Scope: 1 entries ready to capture (no backup yet)                            \u2502\r\n\u2502 Exclusions (not recovered): .git, .timemachine.json, .venv, venv,            \u2502\r\n\u2502 node_modules, __pycache__, .pytest_cache, .mypy_cache, .ruff_cache           \u2502\r\n\u2502                                                                              \u2502\r\n\u2502 Next: timemachine run -- codex                                               \u2502\r\n\u2502 Then: timemachine diff \u00b7 timemachine undo --preview                          \u2502\r\n\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n"]
