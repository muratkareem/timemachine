Screen { background: $background; color: $foreground; }
#brandbar { height: 4; padding: 0 2; border-bottom: heavy $frame; align-vertical: middle; }
#pixel-mark { width: 8; height: 3; color: $primary; text-style: bold; }
#brand { width: 1fr; height: 2; text-style: bold; color: $primary; }
#tagline { width: auto; height: 2; text-align: right; color: $ink-muted; }
#dashboard { grid-size: 4; grid-columns: 1fr 1fr 1fr 1fr; grid-gutter: 0 1; height: 5; margin: 0 2; }
.card { border: solid $frame; padding: 0 1; background: $surface; }
#card-protection { border-left: thick $secondary; }
#card-session { border-left: thick $primary; }
#card-changes { border-left: thick $warning; }
#card-storage { border-left: thick $frame; }
#overview { display: none; height: 1; padding: 0 1; color: $secondary; }
#actions { height: 3; margin: 0 2; }
#actions Button { min-width: 10; width: auto; margin-right: 1; border: tall $frame; height: 3; padding: 0 2; }
Button { background: $panel; color: $foreground; text-style: bold; }
Button.-primary { background: $primary; color: $background; border: tall $primary; }
Button.-warning { background: $warning; color: $background; border: tall $warning; }
Button:focus { text-style: bold underline; tint: $primary 8%; }
Button:disabled { opacity: 55%; }
#action-context { height: 1; margin: 0 2; color: $secondary; }
#notice { height: auto; max-height: 2; min-height: 1; margin: 0 2; color: $ink-muted; }
#notice.error { color: $error; background: $error 8%; }
#notice.success { color: $success; }
#pane-tabs { display: none; height: 3; margin: 0 1; }
#pane-tabs Button { width: 1fr; min-width: 0; height: 3; border: none; padding: 0; }
#pane-tabs .active { color: $primary; border-bottom: heavy $primary; }
#workarea { height: 1fr; margin: 0 2; layout: grid; grid-size: 2; grid-columns: 1fr 1fr; grid-rows: 1fr 1fr; grid-gutter: 0 1; }
#history-pane, #files-pane, #preview-pane { border: double $frame; background: $surface; border-title-color: $secondary; border-title-style: bold; }
#history-pane:focus-within, #files-pane:focus-within, #preview-pane:focus-within { border: double $primary; border-title-color: $primary; }
#filterbar { height: 3; }
Input { background: $surface; color: $foreground; border: none; height: 3; padding: 1 1; }
Input:focus { background: $panel; border-bottom: heavy $primary; padding: 0 1; }
#filter { width: 1fr; }
#kind { width: 16; border: none; }
#timeline, #files { height: 1fr; }
#more { height: 1; min-height: 1; width: 100%; border: none; padding: 0; color: $primary; }
#selection { height: 2; padding: 0 1; color: $ink-muted; }
#preview-pane { column-span: 2; }
#diff-column { width: 1fr; }
#preview-title { height: auto; max-height: 3; padding: 0 1; text-style: bold; }
#find { height: 1; min-height: 1; padding: 0 1; }
#preview { height: 1fr; padding: 0 1; background: $surface; }
#ledger { display: none; width: 33; padding: 0 2; border-left: solid $frame; }
.heading { color: $secondary; text-style: bold; height: 1; }
#ledger-content { height: auto; color: $ink-muted; margin-top: 1; }
#scope-note { height: auto; margin-top: 1; color: $ink-muted; }
#activity { height: 1; padding: 0 2; color: $ink-muted; }
DataTable { background: $surface; }
DataTable > .datatable--header { background: $panel; color: $foreground; text-style: bold; }
DataTable > .datatable--odd-row { background: $surface; }
DataTable > .datatable--even-row { background: $background; }
DataTable > .datatable--cursor { background: $primary 22%; color: $foreground; text-style: bold; }
DataTable:focus > .datatable--cursor { background: $primary; color: $background; }
DataTable > .datatable--header-cursor { background: $panel; color: $foreground; }
Footer { background: $panel; }
.wide #ledger { display: block; }
.short #dashboard, .narrow #dashboard { display: none; }
.short #overview, .narrow #overview { display: block; }
.short #brandbar { height: 3; border: none; }
.short #pixel-mark { display: none; }
.narrow #tagline { display: none; }
.narrow #brandbar { padding: 0 1; }
.narrow #actions, .narrow #notice, .narrow #action-context { margin: 0 1; }
.narrow #refresh-button, .narrow #help-button { display: none; }
.narrow #pane-tabs { display: block; }
.narrow #workarea { layout: vertical; margin: 0 1; }
.narrow #history-pane { width: 100%; height: 1fr; }
.narrow #files-pane, .narrow #preview-pane { display: none; }
.narrow.pane-files #history-pane, .narrow.detail-mode #history-pane { display: none; }
.narrow.pane-files #files-pane { display: block; height: 1fr; }
.narrow.detail-mode #preview-pane { display: block; height: 1fr; }
.narrow #preview-title { max-height: 3; }
.narrow #activity { padding: 0 1; }
.ascii #history-pane, .ascii #files-pane, .ascii #preview-pane { border: ascii $frame; }
.ascii #history-pane:focus-within, .ascii #files-pane:focus-within, .ascii #preview-pane:focus-within { border: ascii $primary; }
#path-filter { height: 1; min-height: 1; padding: 0 1; }
.ascii #dialog, .ascii #help { border: ascii $warning; }
#file-page { height: 1; display: none; }
#file-page Button { width: 1fr; min-width: 0; height: 1; min-height: 1; border: none; padding: 0; color: $primary; }

.narrow.short #brandbar, .narrow.short #brand { height: 1; }
.narrow.short.detail-mode #overview { display: none; }

/* Simple mode keeps technical panels available through explicit disclosure. */
.simple #dashboard, .simple #ledger, .simple #restore-button, .simple #tagline { display: none; }
.simple #overview { display: block; height: auto; max-height: 2; margin: 0 1; }
.simple #pane-tabs { display: block; }
.simple #workarea { grid-size: 2; grid-columns: 1fr 2fr; grid-rows: 1fr; max-height: 32; }
.simple #history-pane { display: none; }
.simple #files-pane { display: block; }
.simple #preview-pane { column-span: 1; }
.simple.pane-history #history-pane { display: block; }
.simple.pane-history #files-pane { display: none; }
.simple.narrow #workarea { layout: vertical; }
.simple.narrow #preview-pane, .simple.narrow #files-pane { display: none; }
.simple.narrow.pane-files #files-pane { display: block; }
.simple.narrow.detail-mode #preview-pane { display: block; }
.simple #actions Button { padding: 0 1; margin-right: 0; }
.simple.narrow #help-button { display: block; min-width: 8; }
.simple.narrow #mode-button { min-width: 14; }
