Screen { background: $background; color: $foreground; }
#brandbar { height: 3; padding: 0 2; background: $surface; align-vertical: middle; }
#brand { width: 1fr; text-style: bold; color: $primary; }
#tagline { width: auto; color: $text-muted; }
#dashboard { grid-size: 4; grid-columns: 1fr 1fr 1fr 1fr; grid-gutter: 1; height: 7; margin: 1 2 0 2; }
.card { border: round $panel; padding: 0 1; background: $surface; }
#overview { display: none; height: 2; padding: 0 1; }
#actions { height: 3; margin: 0 2; }
#actions Button { min-width: 12; margin-right: 1; border: none; height: 3; }
#notice { height: auto; max-height: 5; min-height: 2; padding: 0 2; color: $text-muted; }
#notice.error { color: $error; }
#notice.success { color: $success; }
#workarea { height: 1fr; margin: 0 2; }
#history-pane { width: 38; border: round $panel; background: $surface; }
#filterbar { height: 3; }
#filter { width: 1fr; border: none; }
#kind { width: 15; border: none; }
#timeline { height: 1fr; }
#more { height: 3; min-height: 3; width: 100%; border: none; }
#files-pane { width: 29; border: round $panel; margin-left: 1; background: $surface; }
#files { height: 1fr; }
#selection { height: auto; max-height: 5; padding: 0 1; color: $text-muted; }
#preview-pane { width: 1fr; border: round $panel; margin-left: 1; background: $surface; }
#preview-title { height: auto; max-height: 4; padding: 0 1; text-style: bold; }
#find { height: 3; border: none; }
#preview { height: 1fr; padding: 0 1; }
#activity { height: 1; padding: 0 2; color: $text-muted; }
DataTable { background: $surface; }
DataTable > .datatable--header { background: $panel; color: $foreground; text-style: bold; }
DataTable:focus { border-left: thick $primary; }
Input:focus { border-bottom: solid $primary; }
Button:focus { text-style: bold underline; }
.compact #dashboard { grid-size: 2; height: 10; grid-rows: 4 4; }
.compact #history-pane { width: 34; }
.compact #files-pane { width: 24; }
.narrow #tagline, .narrow #dashboard { display: none; }
.narrow #overview { display: block; }
.narrow #brandbar { padding: 0 1; }
.narrow #actions { margin: 0 1; }
.narrow #refresh-button, .narrow #help-button { display: none; }
.narrow #workarea { layout: vertical; margin: 0 1; }
.narrow #history-pane { width: 100%; height: 1fr; }
.narrow #files-pane, .narrow #preview-pane { display: none; }
.narrow.detail-mode #history-pane { display: none; }
.narrow.detail-mode #files-pane { display: block; width: 100%; height: 7; margin: 0; }
.narrow.detail-mode #preview-pane { display: block; width: 100%; height: 1fr; margin: 0; }
.narrow #selection { display: none; }
.narrow #notice { max-height: 3; padding: 0 1; }
.narrow #activity { padding: 0 1; }
